<div class="grid fade" style="grid-gap:0" id="album-bar">
  {{#if loggedin}}{{else}}
    <a href="/authorize" class="col-f p-sm green-bg dark-blue">Log in with Spotify for the full experience</a>
  {{/if}}
  {{#each items}}
  <img src="{{this.img_url}}" class="col-1" style="object-fit:cover;" preview="{{this.preview_url}}" name="{{this.name}}" artists="{{this.artists}}" title="{{this.name}} - {{this.artists}}">
  </img>
  {{/each}}
</div>

<div id="content" class="p-md fade" style="pointer-events:none;user-select:none">
</div>

<text class="bold center-a" style="animation: fade 5s reverse 1 forwards">
      click any image
  </text>
<script src="./src/main.js" type="module" defer></script>
<script type="x-shader/x-vertex" id="vertexshader">
    varying vec2 vUv;
    void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4( position, 1.0 );
    }
</script>
<script type="x-shader/x-fragment" id="fragmentshader">
    uniform sampler2D baseTexture;
    uniform sampler2D bloomTexture;
    varying vec2 vUv;
    void main() {
        gl_FragColor = ( texture2D( baseTexture, vUv ) + vec4( 1.0 ) * texture2D( bloomTexture, vUv ) );
    }
</script>

<a href="https://dpalmer.in" class="p-sm absolute bottom left small-body fade" target="_blank" style="text-transform:none">by diego palmerin</a>